rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdminSeeder() { return signedIn() && request.auth.uid == "o3Jt0ivnfbRZSoFKL8ty2Uk2b9v2"; }
    function myGroup() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.group;
    }
    function isApproved() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /users/{uid} {
      // Owner can always read their own user doc. Group members can read each other.
      allow read: if isOwner(uid) || (isApproved() && resource.data.group != null && resource.data.group == myGroup());
      // Server-owned wallet + roles.
      allow write: if false;
    }

    match /users/{uid}/ledger/{entryId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /events/{id} {
      // Guests (signed-out) can browse events; signed-in users must be approved.
      allow read: if !signedIn() || isApproved();
      allow write: if isAdminSeeder();
    }

    match /markets/{id} {
      // Guests (signed-out) can browse markets; signed-in users must be approved.
      allow read: if !signedIn() || isApproved();
      allow write: if isAdminSeeder();
    }

    match /bets/{id} {
      // Owner can read own bets; group members can read each other's bets (e.g. Previous Results).
      allow read: if isApproved() && (
        resource.data.uid == request.auth.uid ||
        (resource.data.uid != null && exists(/databases/$(database)/documents/users/$(resource.data.uid)) &&
          get(/databases/$(database)/documents/users/$(resource.data.uid)).data.group == myGroup())
      );
      allow write: if false;
    }

    match /suggestions/{id} {
      // Suggestions are visible to the suggester's group (even before approval).
      allow read: if isApproved() && resource.data.group != null && resource.data.group == myGroup();

      // Approved users can create suggestions only for their own group.
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.group != null
        && request.resource.data.group == myGroup()
        && request.resource.data.status == "pending";

      // Suggestions can only be approved/rejected by server/admin code (Cloud Functions).
      allow update, delete: if false;
    }
  }
}
